# Contoh konfigurasi environment. SALIN ke .env lalu isi nilai aslinya.
# JANGAN commit .env yang sudah terisi.

# ---- Database Neon ----
# DATABASE_URL: dipakai aplikasi saat runtime (connection pooling aktif,
# hostname mengandung "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
# DIRECT_URL: dipakai prisma migrate (connection pooling MATI, tanpa -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ---- Session ----
# Kunci penanda tangan cookie session. Buat nilai acak yang panjang, misalnya:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Kalau diganti, semua sesi yang sedang aktif langsung tidak berlaku.
SESSION_SECRET="ganti-dengan-acak-panjang-minimal-32-karakter"

# ---- Seed akun awal ----
# Dipakai oleh `npm run seed`. Seed bersifat create-if-missing, jadi user yang
# sudah ada tidak akan ditimpa.
SEED_USER_USERNAME="user"
SEED_USER_PASSWORD="ganti-password-ini"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ganti-password-ini"