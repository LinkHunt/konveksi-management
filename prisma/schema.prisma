// Skema database - Web app management konveksi (jasa jahit)
// Database: PostgreSQL (Neon)

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Ukuran dikunci di enum (tidak perlu tabel sendiri).
// Nama enum tidak boleh diawali angka, jadi 2L/3L/5L/8L dipetakan lewat @map.
enum Ukuran {
  XS
  S
  M
  L
  XL
  L2 @map("2L")
  L3 @map("3L")
  L5 @map("5L")
  L8 @map("8L")
}

// BAHAN_KELUAR = bahan yang dibawa penjahit luar
// SETORAN      = hasil jahitan yang disetor balik
enum JenisTransaksi {
  BAHAN_KELUAR
  SETORAN
}

// 2 akun saja: pemakai harian + admin/dev
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Pemilik = pemilik baju
model Pemilik {
  id     Int         @id @default(autoincrement())
  nama   String      @unique
  aktif  Boolean     @default(true)
  models ModelBaju[]
}

model ModelBaju {
  id         Int         @id @default(autoincrement())
  nama       String
  pemilikId  Int
  pemilik    Pemilik     @relation(fields: [pemilikId], references: [id])
  aktif      Boolean     @default(true)
  transaksi  Transaksi[]
  hasilPotong HasilPotong[]
  hasilRiwayat HasilPotongRiwayat[]
  setoranItem SetoranItem[]

  @@unique([pemilikId, nama])
}

model Warna {
  id        Int             @id @default(autoincrement())
  nama      String          @unique
  aktif     Boolean         @default(true)
  items     TransaksiItem[]
  // Relasi ke Transaksi.warnaId yang nullable, hanya dibaca kode lama.
  transaksi Transaksi[]
  hasilPotong HasilPotong[]
  hasilRiwayat HasilPotongRiwayat[]
  setoranItem SetoranItem[]
}

model Penjahit {
  id        Int         @id @default(autoincrement())
  nama      String      @unique
  aktif     Boolean     @default(true)
  transaksi Transaksi[]
}

// Satu baris per kejadian (bahan keluar atau setoran).
// Jumlah per warna + ukuran disimpan di TransaksiItem.
//
// "warnaId" di header sengaja nullable dan hanya dibaca kode versi lama. Codespace
// dan Worker Cloudflare memakai satu database Neon yang sama, jadi selama migrasi
// warna ke item belum selesai di-released, dua versi kode harus bisa INSERT ke
// tabel yang sama. Trigger di database yang mengisi kolom ini dari
// TransaksiItem (kode baru) dan sebaliknya. Hapus setelah Worker sudah jalan
// kode baru.
model Transaksi {
  id         Int             @id @default(autoincrement())
  tanggal    DateTime        @db.Date
  jenis      JenisTransaksi
  penjahitId Int
  penjahit   Penjahit        @relation(fields: [penjahitId], references: [id])
  modelId    Int
  model      ModelBaju       @relation(fields: [modelId], references: [id])
  warnaId    Int?
  warna      Warna?          @relation(fields: [warnaId], references: [id])
  catatan    String?
  createdAt  DateTime        @default(now())
  items      TransaksiItem[]

  @@index([tanggal])
  @@index([penjahitId, jenis])
}

// Warna ada di item, bukan di header. Satu pengambilan bahan sering punya
// lebih dari satu warna, tiap warna dengan ukuran sendiri, jadi warna harus
// ikut per baris. Contoh: Merah XL=4 + Merah 3L=4 + Toska L=20 dalam satu
// transaksi.
model TransaksiItem {
  id          Int       @id @default(autoincrement())
  transaksiId Int
  transaksi   Transaksi @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  warnaId     Int
  warna       Warna     @relation(fields: [warnaId], references: [id])
  ukuran      Ukuran
  jumlah      Int // pcs, harus > 0

  // Warna + ukuran tidak boleh sama dua kali dalam satu transaksi, tapi
  // ukuran yang sama boleh muncul asal warnanya beda.
  @@unique([transaksiId, warnaId, ukuran])
  @@index([warnaId])
}

// Catatan: "sisa belum disetor" dihitung, bukan disimpan.
// Per penjahit + model + warna + ukuran:
//   sisa = SUM(jumlah WHERE jenis = BAHAN_KELUAR) - SUM(jumlah WHERE jenis = SETORAN)

// ---------------------------------------------------------------------------
// Revisi hasil potong (lihat docs/README-revisi-hasil-potong.md)
// ---------------------------------------------------------------------------

// Riwayat perubahan hasil potongan. Dibuat karena koreksi dan penghapusan
// hasil potong diizinkan, tapi harus ada jejaknya (jawaban A3).
enum AksiRiwayat {
  BUAT
  UBAH
  HAPUS
}

// Hasil potongan = sumber data yang benar. Diisi manual mengikuti buku
// hasil potongan milik bibi.
//
// Satu baris per kombinasi model + warna + ukuran. Potongan baru berarti
// model baru, atau model sama dengan angka berbeda — di situ koreksi
// menimpa baris lama, bukan menambah baris kedua.
model HasilPotong {
  id        Int      @id @default(autoincrement())
  modelId   Int
  warnaId   Int
  ukuran    Ukuran
  jumlah    Int // pcs, dicek >= 0 di server
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model ModelBaju @relation(fields: [modelId], references: [id])
  warna Warna     @relation(fields: [warnaId], references: [id])

  @@unique([modelId, warnaId, ukuran])
  @@index([warnaId])
}

// Jejak setiap pembuatan, koreksi, dan penghapusan baris hasil potongan.
//
// `hasilPotongId` sengaja TIDAK dijadikan foreign key dan TIDAK punya relasi
// ke HasilPotong: setelah baris asal dihapus, riwayatnya harus tetap terbaca.
// Kalau pakai FK, riwayat ikut hilang bersama barisnya — justru yang tidak
// diinginkan. Angka id dipertahankan apa adanya supaya riwayat tetap bisa
// dikelompokkan ke baris asalnya selama baris itu masih ada.
model HasilPotongRiwayat {
  id            Int         @id @default(autoincrement())
  hasilPotongId Int
  aksi          AksiRiwayat
  modelId       Int
  warnaId       Int
  ukuran        Ukuran
  jumlahLama    Int? // null saat aksi = BUAT
  jumlahBaru    Int? // null saat aksi = HAPUS
  createdAt     DateTime    @default(now())

  model ModelBaju @relation(fields: [modelId], references: [id])
  warna Warna     @relation(fields: [warnaId], references: [id])

  @@index([hasilPotongId])
  @@index([modelId, warnaId, ukuran])
}

// Setoran hasil jahit ke atasan/bos bibi. Disimpan sebagai riwayat: bisa
// dibuka lagi dan ditambah sampai semua ukuran valid dan tidak ada yang kurang.
model Setoran {
  id        Int      @id @default(autoincrement())
  tanggal   DateTime @db.Date
  catatan   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     SetoranItem[]

  @@index([tanggal])
}

// Pemilik tidak disimpan di sini: cukup ikut dari ModelBaju.pemilikId.
model SetoranItem {
  id        Int     @id @default(autoincrement())
  setoranId Int
  modelId   Int
  warnaId   Int
  ukuran    Ukuran
  jumlah    Int // pcs, dicek > 0 di server

  setoran Setoran   @relation(fields: [setoranId], references: [id], onDelete: Cascade)
  model   ModelBaju @relation(fields: [modelId], references: [id])
  warna   Warna     @relation(fields: [warnaId], references: [id])

  @@unique([setoranId, modelId, warnaId, ukuran])
  @@index([modelId, warnaId, ukuran])
}
